$1.displayName = '$1';

export default $1;
endsnippet

# ---------- Reducer con useReducer ----------
snippet reducer "useReducer con tipos de acción" b
type ${1:State} = {
	${2:campo}: ${3:tipo};
};

type ${4:Action} =
	| { type: '${5:ACCION}'; payload: ${6:tipo} };

const ${7:reducer} = (state: $1, action: $4): $1 => {
	switch (action.type) {
		case '${5}':
			return { ...state, ${2}: action.payload };
		default:
			return state;
	}
};

const [state, dispatch] = useReducer($7, { ${2}: ${8:valorInicial} });
endsnippet
