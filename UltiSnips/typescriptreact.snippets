) : (
	${3:<div>Falso</div>}
)}
endsnippet

# ---------- Context Provider completo ----------
snippet context "Crear un Context con Provider y hook" b
import React, { createContext, useContext, useState, ReactNode } from 'react';

interface ${1:Mi}ContextType {
	${2:valor}: ${3:tipo};
	set${2/(.)(.*)/\u$1$2/}: (value: $3) => void;
}

const ${1}Context = createContext<$1ContextType | undefined>(undefined);

export const ${1}Provider = ({ children }: { children: ReactNode }) => {
	const [${2}, set${2/(.)(.*)/\u$1$2/}] = useState<$3>(${4:valorInicial});

	return (
		<${1}Context.Provider value={{ ${2}, set${2/(.)(.*)/\u$1$2/} }}>
			{children}
		</${1}Context.Provider>
	);
};

export const use${1} = () => {
	const context = useContext(${1}Context);
	if (!context) {
		throw new Error('use${1} debe usarse dentro de un ${1}Provider');
	}
	return context;
};
endsnippet

