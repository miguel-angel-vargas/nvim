# ---------- Fetch de datos con useEffect ----------
snippet fetchue "Fetch de datos dentro de useEffect" b
const [${1:data}, set${1/(.)(.*)/\u$1$2/}] = useState<${2:tipo}[]>([]);
const [loading, setLoading] = useState(true);
const [error, setError] = useState<string | null>(null);

useEffect(() => {
	const fetch${1/(.)(.*)/\u$1$2/} = async () => {
		try {
			setLoading(true);
			const res = await fetch(${3:'/api/endpoint'});
			if (!res.ok) throw new Error('Error en la petición');
			const json = await res.json();
			set${1/(.)(.*)/\u$1$2/}(json);
		} catch (err) {
			setError(err instanceof Error ? err.message : 'Error desconocido');
		} finally {
			setLoading(false);
		}
	};

	fetch${1/(.)(.*)/\u$1$2/}();
}, []);
endsnippet

