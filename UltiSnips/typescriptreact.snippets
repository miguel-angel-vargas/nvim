# ---------- Componente funcional básico ----------
snippet rfc "Componente funcional con props (TypeScript)" b
interface ${1:`!p snip.rv = snip.basename or "Component"`}Props {
	${2:// props}
}

const ${1:`!p snip.rv = snip.basename or "Component"`}: React.FC<${1}Props> = ({ ${3} }) => {
	return (
		<div>
			${4:$1}
		</div>
	);
};

export default ${1};
endsnippet

